# Copy to .env for local Docker Compose. Never commit the real .env.

POSTGRES_DB=nsstore
POSTGRES_USER=nsstore
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

API_PORT=8080
WEB_ORIGIN=http://localhost:5173

# At least 32 characters. Generate with: openssl rand -base64 48
JWT_SIGNING_KEY=

# Bootstrap admin, only used while no user exists. Clear these after the first start.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=
