# Template for ~/ns-store-deploy/.env on the server. That file is hand-maintained and never
# committed — the deploy job only syncs docker-compose.prod.yml, not this.

POSTGRES_DB=nsstore
POSTGRES_USER=nsstore
POSTGRES_PASSWORD=

# At least 32 characters. Generate with: openssl rand -base64 48
JWT_SIGNING_KEY=

# The tunnel's Public Hostname, scheme included, no trailing slash.
# e.g. https://nsstore.example.com
PUBLIC_ORIGIN=

# Token of the Cloudflare Tunnel created for this stack in the Zero Trust dashboard, whose Public
# Hostname points at http://web:80.
CLOUDFLARE_TUNNEL_TOKEN=

# Bootstrap admin. Only used while no user exists.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=

# The seeder skips itself once the catalog has rows, so Enabled is safe to leave on.
# Reset DELETES the demo data and rebuilds it; the reset-demo-data workflow drives it.
SEED_DEMO_ENABLED=true
SEED_DEMO_RESET=false

# LAN port for nginx. 8080 and 8090 are taken on the chromebox.
WEB_PORT=8081

# Development also exposes the Scalar API explorer at /scalar/v1.
ASPNETCORE_ENVIRONMENT=Production
