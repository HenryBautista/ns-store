# Template for the .env that deploy/docker-compose.deploy.yml reads on the server.
# The CI/CD job writes the real file from GitHub Secrets — never commit a filled-in copy.

POSTGRES_DB=nsstore
POSTGRES_USER=nsstore
POSTGRES_PASSWORD=

# At least 32 characters. Generate with: openssl rand -base64 48
JWT_SIGNING_KEY=

# Public origin the Cloudflare Tunnel serves, scheme included, no trailing slash.
# e.g. https://nsstore-dev.example.com
PUBLIC_ORIGIN=

# Bootstrap admin. Only used while no user exists; clear it after the first start.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=

# Demo dataset. Enabled is safe to leave on — the seeder skips itself once the catalog has rows.
# Setting Reset to true DELETES the demo data and rebuilds it; the reset-demo-data workflow is the
# only thing that should ever set it.
SEED_DEMO_ENABLED=true
SEED_DEMO_RESET=false

# Development also exposes the Scalar API explorer at /scalar/v1.
ASPNETCORE_ENVIRONMENT=Production
